#!/bin/bash
# iconManager 生命周期脚本
# CGI 模式：无常驻进程，请求时由 trim_http_cgi 启动 index.cgi。
# 这里只需保证 index.cgi 可执行。

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
CGI_FILE="${TRIM_APPDEST}/ui/index.cgi"

mkdir -p "${TRIM_PKGVAR}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

case $1 in
start)
    log_msg "CGI 模式，无需常驻进程"
    if [ -f "${CGI_FILE}" ]; then
        chmod +x "${CGI_FILE}"
        log_msg "index.cgi 已就绪: ${CGI_FILE}"
        exit 0
    else
        log_msg "ERROR: 找不到 ${CGI_FILE}"
        exit 1
    fi
    ;;
stop)
    # 无进程可停；清理可能残留的 pid
    rm -f "${PID_FILE}"
    log_msg "CGI 模式，无进程需停止"
    exit 0
    ;;
status)
    # CGI 模式恒为运行可用状态
    if [ -x "${CGI_FILE}" ]; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac